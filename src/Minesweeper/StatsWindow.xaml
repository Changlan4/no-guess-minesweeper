<Window x:Class="Minesweeper.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="排行榜与统计"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20">
        <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"/>

        <Border Background="{DynamicResource StatusBarBg}" CornerRadius="8" Padding="16,12" Margin="0,14,0,0">
            <TextBlock x:Name="StatsText" FontSize="13" LineHeight="24"
                       Foreground="{DynamicResource TextPrimary}"/>
        </Border>

        <TextBlock Text="最快记录" FontSize="14" FontWeight="Bold" Margin="0,20,0,8"
                   Foreground="{DynamicResource TextPrimary}"/>

        <ItemsControl x:Name="RecordsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Rank}" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentColor}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Time}"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Date}" FontSize="12" Opacity="0.55"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="EmptyText" Text="还没有完成过这个难度，先赢一局吧"
                   FontSize="13" Opacity="0.6" Margin="0,4,0,0" Visibility="Collapsed"
                   Foreground="{DynamicResource TextPrimary}"/>

        <Button Content="关闭" Width="92" Height="30" HorizontalAlignment="Right" Margin="0,22,0,0"
                Click="OnCloseClick"/>
    </StackPanel>
</Window>
