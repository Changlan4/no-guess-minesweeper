<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 午夜紫罗兰：深紫底 + 暗雾紫格 -->
    <SolidColorBrush x:Key="WindowBackground" Color="#1D1A24"/>
    <SolidColorBrush x:Key="BoardBackground" Color="#151219"/>
    <SolidColorBrush x:Key="CellCoveredFace" Color="#312B3F"/>
    <SolidColorBrush x:Key="CellHighlight" Color="#453D57"/>
    <SolidColorBrush x:Key="CellShadow" Color="#0F0D13"/>
    <SolidColorBrush x:Key="CellRevealed" Color="#262230"/>
    <SolidColorBrush x:Key="CellBorder" Color="#3D3648"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#231F2B"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#DCD5E6"/>
    <SolidColorBrush x:Key="FlagColor" Color="#E89478"/>
    <SolidColorBrush x:Key="AccentColor" Color="#A695DC"/>
    <SolidColorBrush x:Key="FlashColor" Color="#E8C06A"/>

    <SolidColorBrush x:Key="Num1" Color="#6FA8E0"/>
    <SolidColorBrush x:Key="Num2" Color="#6FD08F"/>
    <SolidColorBrush x:Key="Num3" Color="#F08A8A"/>
    <SolidColorBrush x:Key="Num4" Color="#9E8FE0"/>
    <SolidColorBrush x:Key="Num5" Color="#E0928A"/>
    <SolidColorBrush x:Key="Num6" Color="#5FC8C8"/>
    <SolidColorBrush x:Key="Num7" Color="#CFC8D8"/>
    <SolidColorBrush x:Key="Num8" Color="#948DA0"/>

    <!-- 失败时的提示色：插错的旗 / 踩中的那颗雷 -->
    <SolidColorBrush x:Key="WrongFlagColor" Color="#E07070"/>
    <SolidColorBrush x:Key="ExplodedCell" Color="#D4573A"/>

</ResourceDictionary>
