<Application x:Class="Minesweeper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                深色界面的菜单样式。
                放在 Application 这一层（而不是 Menu.Resources），才能同时覆盖顶级菜单项和下拉菜单项，
                并且不会随主题切换被替换掉。
            -->
            <Style TargetType="Menu">
                <Setter Property="Background" Value="{DynamicResource StatusBarBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource StatusBarBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CellBorder}"/>
                <Style.Triggers>
                    <!-- 悬停/高亮：系统默认是浅蓝色块，压在深色菜单上很突兀 -->
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CellHighlight}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 分隔线在深色菜单上是条浅色横杠，很难看；需要分组时用这个低调版本 -->
            <Style TargetType="Separator">
                <Setter Property="Background" Value="{DynamicResource CellBorder}"/>
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="8,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Background="{TemplateBinding Background}" Height="1"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <!--
                    必须用 pack URI 全限定到本程序集。
                    相对 URI（"Themes/X.xaml"）是按「入口程序集」解析的，
                    换个宿主进程（比如测试宿主）就会找不到资源并抛出 XamlParseException。
                -->
                <ResourceDictionary Source="pack://application:,,,/Minesweeper;component/Themes/MintNoir.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
